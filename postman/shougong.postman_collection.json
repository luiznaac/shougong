{
  "info": {
    "name": "shougong",
    "description": "Chinese handwriting SRS trainer. Covers every implemented endpoint.\n\nSet the `baseUrl` collection variable (default http://localhost:8080).\n\nEndpoints: dictionary lookup, the study queue, and the review loop (grade a due item, FSRS reschedules it, history is kept). The dictionary auto-populates from CC-CEDICT on first startup (once), so search results appear a few seconds after the app boots.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "dictionaryEntryId", "value": "1", "type": "string" },
    { "key": "studyItemId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Aggregate health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Runs every registered health check (MySQL connection, outbound HTTP client)."
          }
        },
        {
          "name": "Internal liveness probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/internal",
              "host": ["{{baseUrl}}"],
              "path": ["health", "internal"]
            },
            "description": "Cheap liveness check. Always {\"is_healthy\": true} when the process is up."
          }
        }
      ]
    },
    {
      "name": "Dictionary",
      "item": [
        {
          "name": "Search dictionary entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dictionary-entries?q=学&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["dictionary-entries"],
              "query": [
                { "key": "q", "value": "学", "description": "matches simplified hanzi or pinyin (required)" },
                { "key": "limit", "value": "20", "description": "1..100, default 20" }
              ]
            },
            "description": "Case-insensitive LIKE match on simplified form or pinyin, shortest words first."
          }
        },
        {
          "name": "Get dictionary entry by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dictionary-entries/{{dictionaryEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["dictionary-entries", "{{dictionaryEntryId}}"]
            },
            "description": "404 if the id is unknown."
          }
        }
      ]
    },
    {
      "name": "Study",
      "item": [
        {
          "name": "Add a study item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dictionary_entry_id\": {{dictionaryEntryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/study-items",
              "host": ["{{baseUrl}}"],
              "path": ["study-items"]
            },
            "description": "Enqueues a dictionary entry for study. 201 + Location header; 404 if the entry is unknown, 409 if it is already a study item."
          }
        },
        {
          "name": "List study items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/study-items?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["study-items"],
              "query": [
                { "key": "limit", "value": "50", "description": "1..200, default 50" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "All study items, soonest due first."
          }
        },
        {
          "name": "List due study items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/study-items?due=true",
              "host": ["{{baseUrl}}"],
              "path": ["study-items"],
              "query": [{ "key": "due", "value": "true", "description": "only items with card.due <= now" }]
            },
            "description": "What to practise right now."
          }
        },
        {
          "name": "Get study item by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/study-items/{{studyItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["study-items", "{{studyItemId}}"]
            },
            "description": "404 if the id is unknown."
          }
        },
        {
          "name": "Submit a review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": \"good\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/study-items/{{studyItemId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["study-items", "{{studyItemId}}", "reviews"]
            },
            "description": "Grade a study item — rating is one of again | hard | good | easy. FSRS reschedules the card; 201 + Location, returns the updated item and the logged grade. 404 if the item is unknown, 422 for an unknown rating."
          }
        },
        {
          "name": "List review history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/study-items/{{studyItemId}}/reviews?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["study-items", "{{studyItemId}}", "reviews"],
              "query": [
                { "key": "limit", "value": "50", "description": "1..200, default 50" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "The item's grades, newest first. 404 if the item is unknown."
          }
        }
      ]
    }
  ]
}
