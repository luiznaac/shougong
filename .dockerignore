# Keep the build context small — only backend/ and frontend/ source is needed.

.git
.github
.idea
.vscode
**/*.md

# Python
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.import_linter_cache
**/.coverage
**/coverage.xml
**/htmlcov
**/.env

# Node
**/node_modules
**/dist
**/dist-ssr
**/.vite
**/*.tsbuildinfo

# Not needed inside the image
backend/tests
backend/postman
backend/mysql
docker-compose*.yml
