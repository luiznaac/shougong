# Copy to backend/.env (gitignored) for local runs — pydantic-settings loads it.
# Every value has a sane default in settings.py, so this file is only needed to
# override. Every value here is a dev fixture; no real secret belongs in it. The
# single secrets doc lives in the salgadinhos repo: docs/salgadinhos/secrets.md.
#
# `docker compose up` reads a different file — the gitignored repo-root .env —
# for the GATEWAYS_AI_* values it substitutes in; see the root AGENTS.md.

APP_ENV=dev
HTTP_PORT=8080
LOG_LEVEL=INFO
DICTIONARY_AUTOLOAD=true
HSK_ENRICH_AUTOLOAD=true
STUDY_TIMEZONE=UTC

MYSQL__HOST=localhost
MYSQL__PORT=3306
MYSQL__USER=root
MYSQL__PASSWORD=
MYSQL__DATABASE=shougong

GATEWAYS__APP__HOST=http://localhost:8080
GATEWAYS__AI__BASE_URL=http://localhost:4000
GATEWAYS__AI__API_KEY=
