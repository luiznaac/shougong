# Copy to backend/.env (gitignored) for local runs — pydantic-settings loads it.
# Every value has a sane default in settings.py, so this file is only needed to
# override. Every value here is a dev fixture; no real secret belongs in it. The
# single secrets doc lives in the salgadinhos repo: docs/salgadinhos/secrets.md.
#
# `docker compose up` reads a different file — the gitignored repo-root .env —
# for the GATEWAYS_AI_* values it substitutes in; see the root AGENTS.md.

APP_ENV=dev
# Dev host block; a non-dev APP_ENV keeps 8080/3306 unless these are set.
HTTP_PORT=8130
LOG_LEVEL=INFO
DICTIONARY_AUTOLOAD=true
HSK_ENRICH_AUTOLOAD=true
STUDY_TIMEZONE=UTC

MYSQL__HOST=localhost
MYSQL__PORT=8132
MYSQL__USER=root
MYSQL__PASSWORD=
MYSQL__DATABASE=shougong

# Unset follows HTTP_PORT (http://localhost:<port>); set explicitly to override (container/deploy).
# GATEWAYS__APP__HOST=http://localhost:8130

# External LiteLLM proxy — not part of this project's port block.
GATEWAYS__AI__BASE_URL=http://localhost:4000
GATEWAYS__AI__API_KEY=
# Reasoning tokens count against this ceiling; the reading gateway sends both.
GATEWAYS__AI__REASONING_EFFORT=low
GATEWAYS__AI__MAX_OUTPUT_TOKENS=16000
# One non-streaming generation returns only when the whole text is done; a slow
# reasoning model outlasts a normal HTTP read timeout, so this is generous.
GATEWAYS__AI__GENERATION_TIMEOUT_SECONDS=180
